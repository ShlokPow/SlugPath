{
  "name": "slugpath",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @slugpath/extension dev",
    "build": "pnpm --filter @slugpath/extension build",
    "build:catalog": "node scripts/build-catalog-snapshot.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "htmlparser2": "12.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
